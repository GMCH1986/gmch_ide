{
  "name": "gmch-ide",
  "version": "0.1.0",
  "description": "GMCH IDE — 面向 Java 开发的轻量桌面 IDE",
  "main": "./out/main/index.js",
  "author": "GMCH",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "format": "prettier --write .",
    "doctor": "node scripts/doctor.mjs",
    "backend:build": "node scripts/build-backend.mjs",
    "smoke:backend": "node scripts/smoke-backend.mjs",
    "build:win": "npm run build && npm run backend:build && electron-builder --win",
    "build:mac": "npm run build && npm run backend:build && electron-builder --mac",
    "build:linux": "npm run build && npm run backend:build && electron-builder --linux",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/language": "^6.13.1",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vue-tsc": "^3.1.6"
  }
}
